{
  "name": "monarch-replica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run check:api && vite build",
    "preview": "vite preview",
    "test": "node scripts/selftest.mjs && node scripts/check-api.mjs && node scripts/dbtest.mjs",
    "lint": "oxlint",
    "test:db": "node scripts/dbtest.mjs",
    "check:api": "node scripts/check-api.mjs",
    "test:ui": "node scripts/breakpoints.mjs",
    "icons": "node scripts/icons.mjs",
    "test:e2e": "node scripts/e2etest.mjs",
    "audit": "npm audit --audit-level=moderate --omit=dev",
    "eol": "node scripts/eol.mjs",
    "check": "npm run build && npm run audit && npm run eol && node scripts/selftest.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
